# Copy this file to .env.local and fill in the values.
#
# The agent loads .env.local when run with `uv run src/agent.py ...`, and Docker
# Compose injects the same file into the agent container (env_file in
# docker-compose.yaml). .env.local is git-ignored and excluded from the image.

# --- LiveKit ------------------------------------------------------------------
# Cloud: project credentials from https://cloud.livekit.io, or run:
#   lk app env --write --destination .env.local
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local mode (docker-compose.local.yaml) uses the same three variables. Both
# containers read this file: the agent connects to LIVEKIT_URL, and the bundled
# livekit-server registers LIVEKIT_API_KEY / LIVEKIT_API_SECRET as its API key
# pair, so they always match. Use the service name, not localhost, and a secret
# of at least 32 characters (the server logs an error for shorter ones):
# LIVEKIT_URL=ws://livekit-server:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=local-dev-secret-not-for-production

# --- Model providers ----------------------------------------------------------
# Used by openai.responses.LLM in src/agent.py.
OPENAI_API_KEY=

# --- Optional -----------------------------------------------------------------
# Agent server log level: DEBUG, INFO, WARNING or ERROR. INFO when unset.
# LIVEKIT_LOG_LEVEL=INFO
